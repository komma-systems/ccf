        "number": "8",
        "public": true,
        "resolutionFile": {
          "accessUrl": "https://castroprauxel.gremien.info/api.php?id=69&inline=1&document_type_id=5&agenda_item_id=ni_2024-B2-119%7Czt_3%7C1",
