      },
      {
        "id": "https://castroprauxel.gremien.info/oparl/agendaItem/ni_2024-AuWi-50%7C4%7C1",
        "meeting": "https://castroprauxel.gremien.info/oparl/meeting/ni_2024-AuWi-50",
        "name": "Mitteilungen der Verwaltung",
        "number": "11",
        "public": true,
        "resolutionFile": {
          "accessUrl": "https://castroprauxel.gremien.info/api.php?id=69&inline=1&document_type_id=5&agenda_item_id=ni_2024-AuWi-50%7C4%7C1",
          "date": "2024-04-29",
          "downloadUrl": "https://castroprauxel.gremien.info/api.php?id=69&document_type_id=5&agenda_item_id=ni_2024-AuWi-50%7C4%7C1",
          "fileName": "be_4_1.pdf",
          "id": "https://castroprauxel.gremien.info/oparl/file/be%7Cni_2024-AuWi-50%7C4%7C1",
          "mimeType": "application/pdf",
          "name": "Beschluss - Top 11",
          "size": 93952,
          "text": "11 Mitteilungen der Verwaltung   Herr Ratte berichtet, wie in der letzten Ausschusssitzung erbeten, über den aktuellen Stand bezüglich der Wiederbesetzung der Stabsstellenleitung Digitale Transformation. Ferner teilt Herr Ratte mit, dass zum 01.04.24 in der Stabsstelle eine neue Kollegin mit dem Aufgabenbereich Verwaltungsdigitalisierung ihren Dienst angetreten hat.  Ausschussmitglied Herr Neuhaus fragt den aktuellen Stand zum IT-Sicherheitsbeauftragte/r an.  Herr Ratte nimmt die Anfrage entgegen und wird diese im kommenden Ausschuss für Wirtschaftsentwicklung und Digitalisierung beantworten.   Herr Langensiepen, Geschäftsführer der Wirtschaft & Marketing Castrop-Rauxel GmbH, berichtet über die Veranstaltung zum Projekt H2!Reallabor am 14.3.2024.   Des Weiteren weist Herr Langensiepen auf das CAS IT-Meet-Up am 18.4.2024 und auf die Veranstaltung Smarte Wirtschaft am 24.4.2024 hin.   Der Ausschuss für Wirtschaftsentwicklung und Digitalisierung nimmt den Bericht zur Kenntnis.    \r\n",
          "type": "https://schema.oparl.org/1.0/File"
        },
        "type": "https://schema.oparl.org/1.0/AgendaItem"
      },
