      },
      {
        "consultation": "https://castroprauxel.gremien.info/oparl/consultation/15437",
        "id": "https://castroprauxel.gremien.info/oparl/agendaItem/ni_2025-B2-125%7C380804100076%7C1",
        "meeting": "https://castroprauxel.gremien.info/oparl/meeting/ni_2025-B2-125",
        "name": "Antrag der CDU-Fraktion vom 08.04.2025_Antrag zu Stärkung des Gesundheitsstandortes",
        "number": "7",
        "public": true,
        "resolutionFile": {
          "accessUrl": "https://castroprauxel.gremien.info/api.php?id=69&inline=1&document_type_id=5&agenda_item_id=ni_2025-B2-125%7C380804100076%7C1",
          "date": "2025-05-13",
          "downloadUrl": "https://castroprauxel.gremien.info/api.php?id=69&document_type_id=5&agenda_item_id=ni_2025-B2-125%7C380804100076%7C1",
          "fileName": "be_380804100076_1.pdf",
          "id": "https://castroprauxel.gremien.info/oparl/file/be%7Cni_2025-B2-125%7C380804100076%7C1",
          "mimeType": "application/pdf",
          "name": "Beschluss - Top 7",
          "size": 104240,
          "text": "  7 Antrag der CDU-Fraktion vom 08.04.2025_Antrag zu Stärkung des Gesundheitsstandortes (2025/073)                    Frau Prettenhofer wurde  als Gast des Betriebsausschusses 2  von der                 Ausschussvorsitzenden Frau Lasser-Moryson Rederecht eingeräumt.                Sie stellt sich vor und berichtet ausführlich über ihre Arbeit als selbständige Hebamme                zum Thema Schwangerschaft, Vor- und Nachbegleitung von Frauen.                 Sie stellt ein alternatives Angebot zur Wiege Castrop-Rauxel dar. Die Zukunft der Wiege                ist noch nicht abschließend geklärt.                 Sie wünscht sich mehr Öffentlichkeit und erklärt die Wichtigkeit einer solchen                Institution für Castrop-Rauxel. Herr Fritsch führt aus, dass er die Unternehmens-                entscheidung, die Wiege zu schließen, sehr bedauert. Es soll alles getan werden,                 damit der Gesundheitsstandort Castrop-Rauxel nicht weiter geschwächt wird.                 Mütter und Kinder sollen weiterhin gute Angebote und eine gute Betreuung erhalten.                Frau Prettenhofer bittet die Politik und Verwaltung in diesem Sinne um Unterstützung                und Kooperation. Der Ausschuss bedankt sich bei Frau Prettenhofer für ihren Bericht.                Frau Lasser-Moryson regt an, die Vorlage im Wirtschaftsausschuss beraten zu                 lassen.                 Der Betriebsausschuss 2 stimmt dem Antrag mit Verweis an den Wirtschaftsausschuss                 und in engmaschiger Kooperation mit der Stadtverwaltung Castrop-Rauxel einstimmig                 zu.              \r\n",
          "type": "https://schema.oparl.org/1.0/File"
        },
        "type": "https://schema.oparl.org/1.0/AgendaItem"
