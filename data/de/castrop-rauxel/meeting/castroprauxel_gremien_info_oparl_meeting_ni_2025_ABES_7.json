          "downloadUrl": "https://castroprauxel.gremien.info/api.php?id=69&document_type_id=5&agenda_item_id=ni_2025-ABES-7%7Czt_0%7C1",
          "fileName": "be_zt_0_1.pdf",
          "id": "https://castroprauxel.gremien.info/oparl/file/be%7Cni_2025-ABES-7%7Czt_0%7C1",
