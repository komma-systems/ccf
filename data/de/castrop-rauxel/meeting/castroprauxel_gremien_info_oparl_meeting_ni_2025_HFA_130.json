        "name": "6. Änderung der Vergnügungssteuersatzung vom 31.03.2011 ab 01.01.2026",
        "number": "7",
        "public": true,
        "resolutionFile": {
          "accessUrl": "https://castroprauxel.gremien.info/api.php?id=69&inline=1&document_type_id=5&agenda_item_id=ni_2025-HFA-130%7C380804100077%7C1",
