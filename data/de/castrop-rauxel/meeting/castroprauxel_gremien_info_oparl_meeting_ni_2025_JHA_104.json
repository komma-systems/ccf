        "name": "Weiterentwicklung der Angebotsstruktur von Kindertageseinrichtungen in Castrop-Rauxel, hier: Errichtung einer Waldkita als Dependance",
        "number": "5",
        "public": true,
        "resolutionFile": {
          "accessUrl": "https://castroprauxel.gremien.info/api.php?id=69&inline=1&document_type_id=5&agenda_item_id=ni_2025-JHA-104%7C380409100157%7C1",
