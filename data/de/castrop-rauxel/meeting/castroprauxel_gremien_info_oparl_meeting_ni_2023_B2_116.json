        "name": "Aktuelle Informationen",
        "number": "5.2",
        "public": true,
        "resolutionFile": {
          "accessUrl": "https://castroprauxel.gremien.info/api.php?id=69&inline=1&document_type_id=5&agenda_item_id=ni_2023-B2-116%7Czt_4%7C1",
          "date": "2023-07-28",
          "downloadUrl": "https://castroprauxel.gremien.info/api.php?id=69&document_type_id=5&agenda_item_id=ni_2023-B2-116%7Czt_4%7C1",
          "fileName": "be_zt_4_1.pdf",
          "id": "https://castroprauxel.gremien.info/oparl/file/be%7Cni_2023-B2-116%7Czt_4%7C1",
          "mimeType": "application/pdf",
          "name": "Beschluss - Top 5.2",
          "size": 394305,
          "text": "5.2 Aktuelle Informationen   Regina Kleff, 1. Beigeordnete, informiert, dass die CO2-Messgeräte an die Schulen geliefert  wurden.  Frau Kruck, Bereichsleitung Schule, teilt dem Ausschuss mit, dass der stellvertretende Schulleiter der Willy-Brandt-Gesamtschule, Herr Edeler, in den Ruhestand gegangen ist.  Sein Nachfolger ist Herr Dr. Hans-Volker Schwarz.  Die 1. BG informiert über den Workshop zum Thema Bio-Bitte. Das Ergebnis wird im nächsten Ausschuss präsentiert.      \r\n",
          "type": "https://schema.oparl.org/1.0/File"
        },
        "type": "https://schema.oparl.org/1.0/AgendaItem"
      },
