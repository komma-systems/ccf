        "resolutionFile": {
          "accessUrl": "https://castroprauxel.gremien.info/api.php?id=69&inline=1&document_type_id=5&agenda_item_id=ni_2016-EUV-12%7C201502100003%7C1",
          "date": "2016-03-09",
          "downloadUrl": "https://castroprauxel.gremien.info/api.php?id=69&document_type_id=5&agenda_item_id=ni_2016-EUV-12%7C201502100003%7C1",
          "fileName": "be_201502100003_1.pdf",
          "id": "https://castroprauxel.gremien.info/oparl/file/be%7Cni_2016-EUV-12%7C201502100003%7C1",
          "mimeType": "application/pdf",
          "name": "Beschluss - Top 7",
          "size": 100194,
          "text": "7 Rückwärtsfahren im öffentlichen Straßenraum; Kommunale Entsorgungsfahrzeuge (2016/EUV/004) Vorstand Herr Werner erläutert die Vorlage. Das Rückwärtsfahren ist aufgrund einer Übergangsregelung unter Beachtung und Einhaltung der Arbeitssicherheitsvorschriften in Anliegerstraßen weiter gestattet. Vielfach sind aber parkende Kraftfahrzeuge in den Straßen und insbesondere in den Wendehämmern das Hindernis für den EUV. Der Verwaltungsrat nimmt den Bericht des Vorstandes zur Kenntnis. %anl%; %anl%;\r\n\r\n",
          "type": "https://schema.oparl.org/1.0/File"
        },
        "type": "https://schema.oparl.org/1.0/AgendaItem"
      },
      {
        "consultation": "https://castroprauxel.gremien.info/oparl/consultation/6901",
