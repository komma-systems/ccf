        "resolutionFile": {
          "accessUrl": "https://castroprauxel.gremien.info/api.php?id=69&inline=1&document_type_id=5&agenda_item_id=ni_2016-EUV-12%7Czt_1%7C1",
          "date": "2016-03-09",
          "downloadUrl": "https://castroprauxel.gremien.info/api.php?id=69&document_type_id=5&agenda_item_id=ni_2016-EUV-12%7Czt_1%7C1",
          "fileName": "be_zt_1_1.pdf",
          "id": "https://castroprauxel.gremien.info/oparl/file/be%7Cni_2016-EUV-12%7Czt_1%7C1",
          "mimeType": "application/pdf",
          "name": "Beschluss - Top 6",
          "size": 98562,
          "text": "6 Einsätze Winterdienst 2015/2016 - mündlicher Bericht- Vorstand Herr Werner erklärt, dass im bisherigen Winter 2015/2016 unterdurchschnittliche Winterdienst-Einsätze notwendig waren. Herr Werner macht Aussagen zu den Einsatztagen und zum Streusalzverbrauch. Auf Anfrage von Verwaltungsratsmitglied Herrn Dr. Jankovics erklärt der Vorstand, dass das trocken gelagerte Streusalz auch in der nächsten Winterperiode weiterhin nutzbar ist. Der Verwaltungsrat nimmt den mündlichen Bericht zu den Einsätzen im Winterdienst 2015/2016 zur Kenntnis. %anl%; %anl%;\r\n\r\n",
          "type": "https://schema.oparl.org/1.0/File"
        },
        "type": "https://schema.oparl.org/1.0/AgendaItem"
