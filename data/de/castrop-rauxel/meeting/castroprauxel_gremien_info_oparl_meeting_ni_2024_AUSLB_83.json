      },
      {
        "id": "https://castroprauxel.gremien.info/oparl/agendaItem/ni_2024-AUSLB-83%7C9945%7C1",
        "meeting": "https://castroprauxel.gremien.info/oparl/meeting/ni_2024-AUSLB-83",
